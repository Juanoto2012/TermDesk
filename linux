#!/bin/bash

if pgrep -x Xvfb > /dev/null 2>&1; then
    echo "[!] X11 is already running. Close it first with 'logout'."
    exit 1
fi

if ! command -v Xvfb > /dev/null 2>&1; then
    echo "[!] Xvfb not found. Run './gui.sh' to install X11 packages first."
    exit 1
fi

Xvfb :1 -screen 0 1080x1920x24 -ac &

for i in $(seq 1 10); do
    if command -v xdpyinfo > /dev/null 2>&1 && xdpyinfo -display :1 > /dev/null 2>&1; then
        break
    fi
    if [ "$i" -ge 5 ]; then
        echo "[+] Xvfb started (waiting for display...)"
    fi
    sleep 1
done

export DISPLAY=:1

xfconf-query -c xsettings -p /Net/ThemeName -s "Fluent" 2>/dev/null
xfconf-query -c xsettings -p /Net/IconThemeName -s "Mint-Y" 2>/dev/null
xfconf-query -c xfce4-desktop -p /xfce4-desktop/icon-theme-name -s "Mint-Y" 2>/dev/null
feh --bg-scale "$HOME/.local/share/wallpapers/wall-1.jpg" 2>/dev/null

startxfce4 &

echo "[+] Desktop started. Use 'logout' to exit."